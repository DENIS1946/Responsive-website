{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Launch Edge",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}"
    },
    {
      "type": "firefox",
      "request": "launch",
      "name": "Launch Firefox",
      "url": "http://localhost:5500",
      "webRoot": "${workspaceFolder}",
      "reAttach": true,
      "pathMappings": []
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open with Chrome",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Open with Edge",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "type": "firefox",
      "request": "launch",
      "name": "Open with Firefox",
      "file": "${workspaceFolder}/index.html",
      "reAttach": true
    }
  ]
}
